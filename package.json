{
  "name": "kuro",
  "version": "1.0.0",
  "type": "module",
  "description": "kuro. — Deterministic horror movie discovery engine with a neo-brutalist Japanese editorial grid",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node build",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.2",
    "@libsql/client": "^0.18.0",
    "drizzle-orm": "^0.45.4",
    "zod": "^4.6.6"
  },
  "overrides": {
    "cookie": "^0.7.2"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "^5.2.12",
    "@sveltejs/kit": "^2.19.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@types/node": "^22.10.0",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.31.11",
    "postcss": "^8.5.2",
    "svelte": "^5.25.0",
    "svelte-check": "^4.1.4",
    "tailwindcss": "^3.4.17",
    "vite": "^6.2.0"
  }
}