# TMDB API Key (v3 auth)
# Obtain a free key at https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here

# Google OAuth 2.0 Credentials (Option A 1-Click Authentication)
# Obtain from Google Cloud Console: https://console.cloud.google.com/apis/credentials
# Authorized Redirect URI:
#   Development: http://localhost:5173/api/auth/google/callback
#   Production:  https://yourdomain.com/api/auth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Optional: Email automatically assigned the "admin" role upon sign in
ADMIN_EMAIL=your_email@gmail.com

# Optional: Turso LibSQL Database (recommended for persistent watchlist/auth in serverless)
# DATABASE_URL=libsql://your-database-name.turso.io
# DATABASE_AUTH_TOKEN=your_turso_auth_token_here
