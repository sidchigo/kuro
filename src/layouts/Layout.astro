---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'kuro. — Deterministic Horror Discovery Engine',
  description = 'One film. One sentence. Zero algorithm slop. A neo-brutalist Japanese editorial horror discovery engine.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    
    <!-- Google Fonts: Instrument Serif, IBM Plex Mono, Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Instrument+Serif:ital@0;1&family=Inter:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-[#0A0A0B] text-[#F2EFE9] antialiased selection:bg-[#E62E25] selection:text-[#0A0A0B]">
    <slot />
  </body>
</html>
